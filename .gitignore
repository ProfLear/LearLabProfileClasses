ipython_config.py

# pyenv
#   For a library or app, you might want to share this in the project to support pyenv users
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if lock is tool-specific (like poetry), sometimes developers prefer not to commit it.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock is generally recommended to be committed.
# poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock is generally recommended to be committed.
# pdm.lock

# lsv/uv
#   Since we use uv, it's optional to commit uv.lock, but committing lockfile in a library is generally avoided.
#   Let's keep uv.lock ignored or tracked depending on preference. Usually libraries don't commit locks.
uv.lock

# PEP 582; pyproject.toml project local paths
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

